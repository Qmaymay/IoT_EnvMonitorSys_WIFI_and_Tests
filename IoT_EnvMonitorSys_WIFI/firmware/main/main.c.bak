#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <time.h>
#include <string.h>
#include "../system/logger.h"

#ifdef _WIN32
#include <windows.h>
#else
#include <unistd.h>
#endif

// Simple result codes
typedef enum {
    RESULT_OK = 0,
    RESULT_ERROR = -1
} result_code_t;

// Sensor data
typedef struct {
    float temperature;
    float humidity;
    float air_quality;
    uint32_t timestamp;
} sensor_data_t;

// Device states
typedef enum {
    STATE_INIT,
    STATE_CONNECTING_WIFI,
    STATE_CONNECTING_MQTT,
    STATE_NORMAL,
    STATE_ERROR
} device_state_t;

// Function prototypes
result_code_t sensor_read_all(sensor_data_t* data);
result_code_t wifi_connect(const char* ssid, const char* password);
result_code_t mqtt_connect(const char* broker, int port);
result_code_t mqtt_publish_data(const char* topic, const sensor_data_t* data);
void delay_ms(uint32_t ms);
void log_info(const char* message);

// Configuration
#define WIFI_SSID "MyWiFi"
#define WIFI_PASSWORD "password123"
#define MQTT_BROKER "test.mosquitto.org"
#define MQTT_PORT 1883
#define MQTT_TOPIC "env_monitor/data"
#define SAMPLE_INTERVAL_MS 2000

// Main function
int main(void) {
    sensor_data_t sensor_data;
    device_state_t state = STATE_INIT;
    int retry_count = 0;
    const int max_retries = 3;
    
    // Initialize random seed
    srand((unsigned int)time(NULL));
    
    log_info("=== IoT Environmental Monitor System ===");
    
    while (1) {
        switch (state) {
            case STATE_INIT:
                log_info("Initializing...");
                state = STATE_CONNECTING_WIFI;
                break;
                
            case STATE_CONNECTING_WIFI:
                log_info("Connecting to WiFi...");
                
                if (wifi_connect(WIFI_SSID, WIFI_PASSWORD) == RESULT_OK) {
                    log_info("WiFi connected successfully");
                    state = STATE_CONNECTING_MQTT;
                    retry_count = 0;
                } else {
                    log_info("WiFi connection failed");
                    retry_count++;
                    
                    if (retry_count >= max_retries) {
                        log_info("Max retries reached, entering error state");
                        state = STATE_ERROR;
                    }
                }
                delay_ms(1000);
                break;
                
            case STATE_CONNECTING_MQTT:
                log_info("Connecting to MQTT server...");
                
                if (mqtt_connect(MQTT_BROKER, MQTT_PORT) == RESULT_OK) {
                    log_info("MQTT connected successfully");
                    state = STATE_NORMAL;
                    retry_count = 0;
                } else {
                    log_info("MQTT connection failed");
                    retry_count++;
                    
                    if (retry_count >= max_retries) {
                        log_info("Max retries reached, reconnecting WiFi");
                        state = STATE_CONNECTING_WIFI;
                    }
                }
                delay_ms(1000);
                break;
                
            case STATE_NORMAL:
                // Read sensor data
                if (sensor_read_all(&sensor_data) == RESULT_OK) {
                    // Add timestamp
                    sensor_data.timestamp = (uint32_t)time(NULL);
                    
                    // Display data
                    printf("Temperature: %.1fC, Humidity: %.1f%%, Air Quality: %.0f\n",
                           sensor_data.temperature,
                           sensor_data.humidity,
                           sensor_data.air_quality);
                    
                    // Publish to MQTT
                    if (mqtt_publish_data(MQTT_TOPIC, &sensor_data) != RESULT_OK) {
                        log_info("MQTT publish failed, reconnecting...");
                        state = STATE_CONNECTING_MQTT;
                    }
                } else {
                    log_info("Sensor read failed");
                }
                
                // Wait for next sample
                delay_ms(SAMPLE_INTERVAL_MS);
                break;
                
            case STATE_ERROR:
                log_info("Error state, waiting for recovery...");
                delay_ms(5000);  // Wait 5 seconds before retry
                state = STATE_CONNECTING_WIFI;
                break;
        }
    }
    
    return 0;
}

// Simulated sensor reading
result_code_t sensor_read_all(sensor_data_t* data) {
    // Simulated sensor data
    static float base_temp = 25.0f;
    static float base_humidity = 60.0f;
    static float base_air = 50.0f;
    
    // Add random variation
    data->temperature = base_temp + ((rand() % 100) / 10.0f - 5.0f);
    data->humidity = base_humidity + ((rand() % 100) / 10.0f - 5.0f);
    data->air_quality = base_air + (rand() % 50);
    
    // Clamp to reasonable ranges
    if (data->temperature < -20.0f) data->temperature = -20.0f;
    if (data->temperature > 50.0f) data->temperature = 50.0f;
    if (data->humidity < 0.0f) data->humidity = 0.0f;
    if (data->humidity > 100.0f) data->humidity = 100.0f;
    if (data->air_quality < 0.0f) data->air_quality = 0.0f;
    
    return RESULT_OK;
}

// Simulated WiFi connection
result_code_t wifi_connect(const char* ssid, const char* password) {
    log_info("Attempting to connect to WiFi...");
    
    // Simulate 80% success rate
    if ((rand() % 100) < 80) {
        return RESULT_OK;
    }
    return RESULT_ERROR;
}

// Simulated MQTT connection
result_code_t mqtt_connect(const char* broker, int port) {
    printf("Connecting to MQTT: %s:%d\n", broker, port);
    
    // Simulate 90% success rate
    if ((rand() % 100) < 90) {
        return RESULT_OK;
    }
    return RESULT_ERROR;
}

// Simulated MQTT publish
result_code_t mqtt_publish_data(const char* topic, const sensor_data_t* data) {
    printf("Publishing to: %s\n", topic);
    printf("Data: %.1fC, %.1f%%, %.0f\n", 
           data->temperature, data->humidity, data->air_quality);
    
    // Simulate 95% success rate
    if ((rand() % 100) < 95) {
        return RESULT_OK;
    }
    return RESULT_ERROR;
}

// Utility: delay function
void delay_ms(uint32_t ms) {
#ifdef _WIN32
    Sleep(ms);
#else
    usleep(ms * 1000);
#endif
}

